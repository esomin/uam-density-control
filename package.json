{
  "name": "uam-density-control",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"SCH,SIM,DSH\" -c \"bgGreen,bgBlue,bgMagenta\" \"pnpm --filter @uam/scheduler dev\" \"pnpm --filter @uam/simulator dev\" \"pnpm --filter @uam/dashboard dev\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "benchmark:steady": "npx tsx scripts/benchmark-e2e.ts --mode=steady",
    "benchmark:stress": "npx tsx scripts/benchmark-e2e.ts --mode=stress",
    "benchmark:io-isolation": "npx tsx scripts/benchmark-io-isolation.ts",
    "verify:persistence": "npx tsx scripts/verify-persistence.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@uam/types": "workspace:*",
    "concurrently": "^9.2.1",
    "ioredis": "^5.9.3",
    "mqtt": "^5.15.0",
    "pg": "^8.23.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15",
    "turbo": "^2.8.11",
    "typescript": "^7.0.2"
  }
}
